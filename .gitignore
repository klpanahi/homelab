# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfstate.backup
terraform/terraform.tfvars
terraform/.terraform.lock.hcl
terraform/crash.log

# Ansible
ansible/.vault_pass
ansible/.vault_pass*
ansible/*.retry
ansible/group_vars/all/vault.yml
ansible/collections/

# Galaxy roles get installed into ansible/roles/ and must stay ignored, but
# hand-written roles (cloudflared, backup) are tracked source and live in
# this same directory. Git won't descend into an ignored directory, so a
# plain "!ansible/roles/cloudflared/" negation here does not reliably work.
# Hand-written roles are instead force-added individually with
# `git add -f ansible/roles/<name>`.
# ansible/roles/

# Credentials — never commit. Only *.example files are tracked.
*.tfvars
!*.tfvars.example
vault.yml
!vault.yml.example
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*

# Local tooling
**/.claude/settings.local.json

# General
.DS_Store
*.swp
ansible/roles/cloudflared/
ansible/roles/geerlingguy.*
