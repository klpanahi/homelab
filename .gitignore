# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfstate.backup
terraform/terraform.tfvars
terraform/.terraform.lock.hcl
terraform/crash.log

# Ansible
ansible/.vault_pass
ansible/.vault_pass*
ansible/*.retry
ansible/group_vars/all/vault.yml
ansible/collections/

# Galaxy roles get installed into ansible/roles/ and must stay ignored, but
# hand-written roles are tracked source living in the same directory.
# Ignore the directory's CHILDREN (ansible/roles/*), not the directory itself:
# git never re-includes anything under an excluded directory, so
# "ansible/roles/" + "!ansible/roles/<name>/" silently fails, whereas
# "ansible/roles/*" + "!ansible/roles/<name>/" works. No `git add -f` needed —
# add a negation line here when you add a hand-written role.
ansible/roles/*
!ansible/roles/backup/
!ansible/roles/router/

# Credentials — never commit. Only *.example files are tracked.
*.tfvars
!*.tfvars.example
vault.yml
!vault.yml.example
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*

# Local tooling
**/.claude/settings.local.json

# General
.DS_Store
*.swp
ansible/roles/cloudflared/
ansible/roles/geerlingguy.*
