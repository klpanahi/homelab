# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfstate.backup
terraform/terraform.tfvars
terraform/.terraform.lock.hcl
terraform/crash.log

# Ansible
ansible/.vault_pass
ansible/.vault_pass*
ansible/*.retry
ansible/group_vars/all/vault.yml
ansible/collections/

# Galaxy roles get installed into ansible/roles/ and must stay ignored, but
# hand-written roles live in that same directory and are tracked source.
# The pattern has to exclude the directory's CHILDREN (ansible/roles/*), not the
# directory itself — git will not descend into an excluded directory, so a
# negation under a plain "ansible/roles/" is silently ignored. In this form the
# negations below work and `git add -f` is not needed.
ansible/roles/*
!ansible/roles/backup/
!ansible/roles/router/
# cloudflared is hand-written but deliberately not committed — it stays local,
# covered by the ansible/roles/* rule above with no negation.

# Credentials — never commit. Only *.example files are tracked.
*.tfvars
!*.tfvars.example
vault.yml
!vault.yml.example
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*

# Local tooling
**/.claude/settings.local.json

# General
.DS_Store
*.swp
