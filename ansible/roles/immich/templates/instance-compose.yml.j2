# {{ ansible_managed }}
# Immich instance "{{ item.name }}", adapted from Immich's docker-compose.yml for
# {{ immich_version }}: no container_name (several instances share this host),
# no ML service (the shared one in {{ immich_compose_root }}/ml is used instead).

name: immich-{{ item.name }}

services:
  immich-server:
    image: ghcr.io/immich-app/immich-server:${IMMICH_VERSION}
    volumes:
      - ${UPLOAD_LOCATION}:/data
      - /etc/localtime:/etc/localtime:ro
    env_file:
      - .env
    ports:
      - "{{ item.port }}:2283"
    networks:
      - default
      - immich-ml
    depends_on:
      - redis
      - database
    restart: always
    healthcheck:
      disable: false

  redis:
    image: {{ immich_redis_image }}
    healthcheck:
      test: redis-cli ping | grep -q PONG || exit 1
    restart: always

  database:
    image: {{ immich_postgres_image }}
    environment:
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_USER: ${DB_USERNAME}
      POSTGRES_DB: ${DB_DATABASE_NAME}
      POSTGRES_INITDB_ARGS: "--data-checksums"
    volumes:
      - ${DB_DATA_LOCATION}:/var/lib/postgresql/data
    shm_size: 128mb
    restart: always
    healthcheck:
      disable: false
{% if item.public_share is defined %}

  # Serves only what is shared by link, so share links work from the internet
  # while this instance stays private. https://github.com/alangrainger/immich-public-proxy
  immich-public-proxy:
    image: {{ immich_public_proxy_image }}
    environment:
      PUBLIC_BASE_URL: {{ item.public_share.base_url }}
      IMMICH_URL: http://immich-server:2283
    ports:
      - "{{ item.public_share.port }}:3000"
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges
    depends_on:
      - immich-server
    restart: always
    healthcheck:
      test: curl -sf -m 4 http://localhost:3000/share/healthcheck -o /dev/null || exit 1
      start_period: 10s
      timeout: 5s
{% endif %}

networks:
  immich-ml:
    external: true
