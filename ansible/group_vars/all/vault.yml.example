# Template for the vaulted secrets file. Create the real, encrypted, gitignored
# file with:  ansible-vault create group_vars/all/vault.yml
#
# proxmox_token_secret is the SECRET half of the Proxmox API token (the part
# after '=' in terraform.tfvars' proxmox_api_token). The inventory reads it via
# an ansible.builtin.unvault lookup at parse time (inventory plugins load before
# group_vars, so it can't be referenced as a plain group var). The hosts are
# one cluster, so this single token covers VMs on both nodes. Any future
# play-level secrets can live here too.
proxmox_token_secret: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# vault_ha_token is a Home Assistant long-lived access token for an ADMIN
# user, used by the backup role to call HA's API at http://homeassistant.home.arpa:8123
# to trigger/fetch a Home Assistant backup over HTTP. Create one from the HA
# web UI: profile -> Security -> Long-lived access tokens.
vault_ha_token: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# vault_backup_ssh_private_key is an ed25519 PRIVATE key the backup VM uses to
# SSH to the docker VM and run pg_dump. Generate the keypair ONCE on the
# operator's Mac (not on the VM itself) and paste the private half here:
#   ssh-keygen -t ed25519 -f /tmp/backup_key -N "" -C "backup@homelab1"
# Generating it on the Mac rather than on the backup VM keeps site.yml a
# single pass with no play-ordering dependency (the docker play can install
# the public key without waiting on the backup VM to exist and generate one
# first). The PUBLIC half goes in group_vars/all/vars.yml as
# backup_ssh_public_key (not a secret, tracked in plaintext).
#
# No Postgres credentials are needed here: the dump script reads
# $POSTGRES_USER from inside the running container on the docker VM, so
# there's no separate DB username/password to vault.
vault_backup_ssh_private_key: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
  xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
  -----END OPENSSH PRIVATE KEY-----
