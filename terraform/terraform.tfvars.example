proxmox_endpoint  = "https://192.168.68.65:8006"
proxmox_api_token = "terraform@pve!terraform=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
proxmox_node      = "homelab2"
haos_version      = "17.3"   # check https://github.com/home-assistant/operating-system/releases

# Static IP for Home Assistant — leave haos_static_ip empty to keep DHCP
haos_static_ip     = "192.168.68.100/24"
haos_gateway       = "192.168.68.1"
haos_nameserver    = "8.8.8.8"
# haos_network_iface = "enp0s18"   # default; Q35 machine with virtio NIC

# nginx VM — run `cat ~/.ssh/id_ed25519.pub` to get your public key
nginx_ssh_public_key = "ssh-ed25519 AAAA... you@host"
# nginx_vm_id      = 201          # default
# nginx_cpu_cores  = 1            # default
# nginx_memory_mb  = 1024         # default (1 GB)
# nginx_disk_gb    = 20           # default
# nginx_static_ip  = "192.168.68.101/24"   # leave empty to use DHCP + Deco MAC reservation
# nginx_gateway    = "192.168.68.1"
# nginx_nameserver = "8.8.8.8"
