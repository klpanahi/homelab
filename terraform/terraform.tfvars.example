proxmox_endpoint  = "https://192.168.68.65:8006"
proxmox_api_token = "terraform@pve!terraform=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
proxmox_node      = "homelab2"
haos_version      = "17.3"   # check https://github.com/home-assistant/operating-system/releases

# Static IP for Home Assistant — leave haos_static_ip empty to keep DHCP
haos_static_ip     = "192.168.68.100/24"
haos_gateway       = "192.168.68.1"
haos_nameserver    = "8.8.8.8"
# haos_network_iface = "enp0s18"   # default; Q35 machine with virtio NIC

# nginx VM — run `cat ~/.ssh/id_ed25519.pub` to get your public key
nginx_ssh_public_key = "ssh-ed25519 AAAA... you@host"
# nginx_vm_id      = 201          # default
# nginx_cpu_cores  = 1            # default
# nginx_memory_mb  = 1024         # default (1 GB)
# nginx_disk_gb    = 20           # default
# nginx_static_ip  = "192.168.68.101/24"   # leave empty to use DHCP + Deco MAC reservation
# nginx_gateway    = "192.168.68.1"
# nginx_nameserver = "8.8.8.8"

# ── lab router / NAT gateway (VM 204) ─────────────────────────────────────────
# Routes the lab subnet onto the LAN. Defaults below match variables.tf, so all
# of these can be omitted. Design + runbook: docs/lab-subnet.md
#
# NOTE the Deco LAN is a /22 (192.168.68.1–192.168.71.254), not a /24.
# router_lan_ip      = "192.168.68.50/22"   # must sit outside the Deco DHCP pool
# router_lan_gateway = "192.168.68.1"
# router_lab_ip      = "10.10.10.1/24"      # gateway address lab VMs point at
# router_nameserver  = "8.8.8.8"
# router_vm_id       = 204
# router_cpu_cores   = 1
# router_memory_mb   = 1024
# router_disk_gb     = 10

# Putting a VM on the lab subnet needs no new Terraform — just point its existing
# static-IP vars at the lab range, e.g.:
# docker_static_ip = "10.10.10.20/24"
# docker_gateway   = "10.10.10.1"
#
# For a VM that is already running, changing these alone is NOT enough — cloud-init
# writes network config once. See "Moving an existing VM" in docs/lab-subnet.md.
