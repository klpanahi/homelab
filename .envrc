# direnv: loaded automatically when you cd into the repo (after `direnv allow`).
# Without direnv, run `source .envrc` from the repo root before using Ansible.
#
# Lets Ansible's Proxmox inventory verify the cluster's self-signed API cert.
# REQUESTS_CA_BUNDLE *replaces* Python's default trust store, so pointing it at
# the Proxmox CA alone would break public HTTPS for any Python tool run here.
# Build a bundle of the macOS system roots plus the cluster CA instead, and keep
# it scoped to this directory. See docs/cluster.md, "TLS certificates".
ca="$PWD/ansible/files/pve-root-ca.pem"
if [ ! -f "$ca" ]; then
  echo ".envrc: $ca not found — run this from the repo root" >&2
  return 1
fi
bundle="$PWD/.direnv/ca-bundle.pem"
mkdir -p "$PWD/.direnv"
cat /etc/ssl/cert.pem "$ca" > "$bundle"
export REQUESTS_CA_BUNDLE="$bundle"

# direnv-only helper: rebuild the bundle when the CA file changes.
if type watch_file >/dev/null 2>&1; then
  watch_file "$ca"
fi
